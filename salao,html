<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salão do Dê - Alemoa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #121212; color: #f3f4f6; }
        
        /* Barber Pole Animation */
        .barber-pole {
            height: 12px;
            width: 100%;
            background: repeating-linear-gradient(
                -45deg,
                #ffffff,
                #ffffff 15px,
                #cc0000 15px,
                #cc0000 30px,
                #ffffff 30px,
                #ffffff 45px,
                #111111 45px,
                #111111 60px
            );
            background-size: 85px 85px;
            animation: barberpole 2s linear infinite;
        }
        @keyframes barberpole { 100% { background-position: 85px 0; } }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1f2937; }
        ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #6b7280; }

        .service-btn.selected { border-color: #f59e0b; background-color: rgba(245, 158, 11, 0.1); }
        .hidden { display: none !important; }
        .pulse-red { animation: pulseRed 1.5s infinite; }
        @keyframes pulseRed { 0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); } 70% { box-shadow: 0 0 0 15px rgba(220, 38, 38, 0); } 100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); } }
    </style>
</head>
<body class="flex flex-col min-h-screen">
    <div class="barber-pole sticky top-0 z-50"></div>
    <header class="bg-black border-b border-neutral-800 p-4 sticky top-3 z-40 shadow-md">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3 cursor-pointer" onclick="navigate('home')">
                <div class="w-10 h-10 bg-amber-500 rounded-full flex items-center justify-center text-black font-black text-xl shadow-[0_0_15px_rgba(245,158,11,0.5)]">D</div>
                <div>
                    <h1 class="font-black text-xl text-white tracking-widest uppercase">Salão do Dê</h1>
                    <p class="text-xs text-amber-500 tracking-wider uppercase">Alemoa</p>
                </div>
            </div>
            <button id="btn-logout" class="hidden text-xs bg-neutral-800 border border-neutral-700 text-gray-300 px-3 py-1.5 rounded hover:bg-neutral-700 transition" onclick="doLogout()">Sair</button>
        </div>
    </header>

    <main class="flex-1 max-w-6xl w-full mx-auto p-4 w-full relative">
        <div id="view-loading" class="flex flex-col items-center justify-center py-20">
            <div class="w-12 h-12 border-4 border-neutral-700 border-t-amber-500 rounded-full animate-spin mb-4"></div>
            <p class="text-neutral-400 font-bold animate-pulse">Conectando ao sistema...</p>
        </div>

        <div id="view-home" class="hidden flex flex-col items-center justify-center py-10 md:py-20">
            <div class="text-center mb-10">
                <h2 class="text-3xl md:text-5xl font-black text-white mb-4">O SEU ESTILO<br><span class="text-amber-500">EM BOAS MÃOS</span></h2>
                <p class="text-neutral-400">Agende seu horário de forma rápida e prática.</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-4 w-full max-w-md">
                <button onclick="goToClient()" class="flex-1 bg-amber-500 hover:bg-amber-600 text-black font-black py-4 px-6 rounded-xl shadow-lg transition-transform transform hover:-translate-y-1">SOU CLIENTE</button>
                <button onclick="goToAdmin()" class="flex-1 bg-neutral-800 hover:bg-neutral-700 text-white border border-neutral-700 font-bold py-4 px-6 rounded-xl shadow-lg transition-transform transform hover:-translate-y-1">ADMINISTRADOR</button>
            </div>
        </div>

        <!-- Tela de Autenticação do Cliente -->
        <div id="view-client-auth" class="hidden max-w-md mx-auto mt-10">
            <div class="bg-neutral-900 p-8 rounded-2xl border border-neutral-800 shadow-2xl">
                <h3 class="text-2xl font-black text-white mb-6 text-center">Acesso do Cliente</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-bold text-neutral-400 mb-1">E-mail</label>
                        <input type="email" id="client-email" class="w-full bg-black border border-neutral-800 text-white rounded-lg p-3 focus:border-amber-500 focus:outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-neutral-400 mb-1">Senha</label>
                        <input type="password" id="client-pass" class="w-full bg-black border border-neutral-800 text-white rounded-lg p-3 focus:border-amber-500 focus:outline-none transition">
                    </div>
                    <div class="flex gap-3 pt-2">
                        <button onclick="handleClientLogin()" class="flex-1 bg-amber-500 hover:bg-amber-600 text-black font-black py-3 rounded-lg transition">ENTRAR</button>
                        <button onclick="handleClientRegister()" class="flex-1 bg-neutral-800 border border-neutral-700 text-amber-500 hover:bg-neutral-700 font-black py-3 rounded-lg transition">CRIAR CONTA</button>
                    </div>
                    <button onclick="navigate('home')" class="w-full mt-2 text-neutral-500 hover:text-white text-sm font-bold py-2">Voltar</button>
                </div>
            </div>
        </div>

        <!-- Tela de Autenticação do Admin -->
        <div id="view-admin-login" class="hidden max-w-md mx-auto mt-10">
            <div class="bg-neutral-900 p-8 rounded-2xl border border-neutral-800 shadow-2xl">
                <h3 class="text-2xl font-black text-white mb-6 text-center">Painel Restrito</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-bold text-neutral-400 mb-1">E-mail do Administrador</label>
                        <input type="email" id="admin-email" class="w-full bg-black border border-neutral-800 text-white rounded-lg p-3 focus:border-amber-500 focus:outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-neutral-400 mb-1">Senha</label>
                        <input type="password" id="admin-pass" class="w-full bg-black border border-neutral-800 text-white rounded-lg p-3 focus:border-amber-500 focus:outline-none transition">
                    </div>
                    <div class="flex gap-3 pt-2">
                        <button onclick="handleAdminAuth(false)" class="flex-1 bg-amber-500 hover:bg-amber-600 text-black font-black py-3 rounded-lg transition">ENTRAR</button>
                        <button onclick="handleAdminAuth(true)" class="flex-1 bg-neutral-800 border border-neutral-700 text-neutral-400 hover:bg-neutral-700 font-bold py-3 rounded-lg transition text-sm">Criar Acesso</button>
                    </div>
                    <button onclick="navigate('home')" class="w-full mt-2 text-neutral-500 hover:text-white text-sm font-bold py-2">Voltar</button>
                </div>
            </div>
        </div>

        <div id="view-user" class="hidden">
            <!-- Alertas em Tempo Real (Cliente) -->
            <div id="client-notification-area" class="mb-6 empty:hidden"></div>

            <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-4 md:p-6 mb-6">
                <h3 class="text-lg font-black text-white mb-4 border-b border-neutral-800 pb-2">1. Escolha a Data</h3>
                <input type="date" id="client-date" class="w-full bg-black border border-neutral-700 text-white p-3 rounded-lg text-lg focus:border-amber-500 outline-none" onchange="renderUserView()">
                <p id="client-date-msg" class="text-red-400 text-sm font-bold mt-2 hidden">O salão não abre neste dia.</p>
            </div>

            <div id="client-booking-section" class="space-y-6">
                <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-4 md:p-6">
                    <h3 class="text-lg font-black text-white mb-4 border-b border-neutral-800 pb-2">2. Selecione os Serviços</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="client-services">
                        <!-- Renderizado via JS -->
                    </div>
                    <div class="mt-4 pt-4 border-t border-neutral-800 flex justify-between items-center">
                        <span class="text-neutral-400 font-bold">Total:</span>
                        <span id="client-total" class="text-2xl font-black text-amber-500">R$ 0,00</span>
                    </div>
                </div>

                <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-4 md:p-6">
                    <h3 class="text-lg font-black text-white mb-4 border-b border-neutral-800 pb-2">3. Como quer ser chamado?</h3>
                    <input type="text" id="client-name" placeholder="Seu nome ou apelido" class="w-full bg-black border border-neutral-700 text-white p-3 rounded-lg focus:border-amber-500 outline-none">
                </div>

                <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-4 md:p-6">
                    <h3 class="text-lg font-black text-white mb-4 border-b border-neutral-800 pb-2">4. Horários Livres</h3>
                    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3" id="client-slots">
                        <!-- Renderizado via JS -->
                    </div>
                </div>
            </div>

            <!-- Meus Agendamentos -->
            <div id="client-my-appointments" class="mt-10 hidden">
                <h3 class="text-xl font-black text-amber-500 mb-4 border-b border-neutral-800 pb-2">Meus Cortes Agendados</h3>
                <div id="client-my-appointments-list" class="space-y-3"></div>
            </div>
        </div>

        <div id="view-admin-dashboard" class="hidden">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-neutral-900 border border-neutral-800 p-4 md:p-6 rounded-2xl mb-6 gap-4">
                <div>
                    <label class="block text-xs font-bold text-neutral-400 uppercase tracking-wider mb-1">Data da Agenda</label>
                    <input type="date" id="admin-date" class="bg-black border border-neutral-700 text-white p-2 rounded-lg text-lg focus:border-amber-500 outline-none font-bold" onchange="renderAdminDashboard()">
                </div>
                <div class="flex items-center gap-4 w-full md:w-auto justify-between border-t border-neutral-800 md:border-t-0 pt-4 md:pt-0">
                    <div class="text-right">
                        <p class="text-xs font-bold text-neutral-400 uppercase tracking-wider mb-1">Caixa do Dia</p>
                        <p id="admin-revenue" class="text-2xl font-black text-green-500">R$ 0,00</p>
                    </div>
                    <button id="btn-toggle-day" onclick="toggleDayStatus()" class="px-4 py-2 rounded-lg font-bold border transition"></button>
                </div>
            </div>

            <div class="flex gap-4 mb-4 text-xs font-bold text-neutral-400 flex-wrap">
                <div class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-neutral-800 border border-neutral-600"></span> Livre</div>
                <div class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-amber-500"></span> Agendado</div>
                <div class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-red-600 pulse-red"></span> Em Corte</div>
                <div class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-green-600"></span> Finalizado</div>
            </div>

            <div class="bg-neutral-900 border border-neutral-800 p-4 md:p-6 rounded-2xl">
                <div id="admin-slots" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
                    <!-- Renderizado via JS -->
                </div>
            </div>
        </div>
    </main>

    <div class="barber-pole mt-auto"></div>

    <div id="modal-backdrop" class="fixed inset-0 bg-black bg-opacity-80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-neutral-900 border border-neutral-700 rounded-2xl w-full max-w-md shadow-2xl transform scale-95 transition-transform duration-200 p-6 relative" id="modal-content-container">
            <h3 id="modal-title" class="text-xl font-black text-amber-500 mb-4 border-b border-neutral-800 pb-2">Título</h3>
            <div id="modal-body" class="text-white space-y-4"></div>
            <div id="modal-footer" class="mt-6 flex gap-3"></div>
        <button onclick="closeModal()" class="absolute top-4 right-4 text-neutral-500 hover:text-white">✕</button>
    </div>
</div>

<!-- AVISO DE ERRO FIREBASE / GITHUB PAGES -->
<div id="setup-error-backdrop" class="fixed inset-0 bg-black bg-opacity-90 backdrop-blur-sm z-[60] hidden flex items-center justify-center p-4">
    <div class="bg-neutral-900 border-2 border-red-600 rounded-2xl w-full max-w-lg shadow-2xl p-6 relative">
        <h3 class="text-2xl font-black text-red-500 mb-4 border-b border-neutral-800 pb-2">⚠️ Erro de Permissão no Firebase</h3>
        <div class="text-white space-y-4 text-sm">
            <p>O aplicativo tentou conectar ao seu banco de dados, mas foi bloqueado pelas regras de segurança do Firebase.</p>
            <p class="font-bold text-amber-500">Como corrigir (Passo a Passo):</p>
            <ol class="list-decimal pl-5 space-y-2 text-neutral-300">
                <li>Vá no seu <a href="https://console.firebase.google.com/" target="_blank" class="text-blue-400 underline">Console do Firebase</a> e acesse seu projeto <b>desafio-7-dias-d3680</b>.</li>
                <li>No menu esquerdo, clique em <b>Firestore Database</b> e vá na aba <b>Regras (Rules)</b>.</li>
                <li>Mude a regra para permitir leitura e escrita:<br>
                    <code class="block bg-black p-2 mt-1 border border-neutral-700 rounded text-green-400 font-mono">allow read, write: if true;</code>
                </li>
                <li>No menu esquerdo, vá em <b>Authentication</b> > Aba <b>Settings (Configurações)</b> > <b>Authorized domains</b> e adicione seu domínio do GitHub Pages (ex: <i>seu-usuario.github.io</i>).</li>
                <li>Ainda em Authentication, na aba <b>Sign-in method</b>, ative a opção <b>Provedor de E-mail/Senha</b>.</li>
            </ol>
        </div>
        <div class="mt-6">
            <button onclick="document.getElementById('setup-error-backdrop').classList.add('hidden')" class="w-full bg-neutral-700 hover:bg-neutral-600 text-white font-bold py-3 rounded-lg transition">Entendi, vou configurar!</button>
        </div>
    </div>
</div>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, collection, query, onSnapshot, addDoc, updateDoc, deleteDoc, doc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Configuração do Firebase fornecida pelo usuário
        const firebaseConfig = {
            apiKey: "AIzaSyCyRPstlq91unKjiWmHEktAUXgCtfVWTFU",
            authDomain: "desafio-7-dias-d3680.firebaseapp.com",
            projectId: "desafio-7-dias-d3680",
            storageBucket: "desafio-7-dias-d3680.firebasestorage.app",
            messagingSenderId: "981540824605",
            appId: "1:981540824605:web:f35d6a0616a3bce54308f4",
            measurementId: "G-J7NXMXCQ56"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);

        // O prompt do sistema exige este caminho. Usarei o projectId como appId para manter isolamento.
        const APP_ID = 'salao-do-de-alemoa'; 

        // --- Configurações de Negócio ---
        const SERVICES = [
            { id: 'pezinho', name: 'Pézinho', price: 10, estTime: 5 }, // tempo para chamar proximo
            { id: 'corte', name: 'Corte', price: 30, estTime: 15 },
            { id: 'barba', name: 'Barba', price: 25, estTime: 15 }
        ];

        // --- Estado Global ---
        let currentUser = null;
        let currentView = 'loading';
        let appointments = [];
        let settings = [];
        
        // Estado do Cliente
        let clientSelectedServices = [];
        let realtimeLoopInterval = null;

        window.formatCurrency = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(v);
        window.getToday = () => new Date().toLocaleDateString('en-CA'); // YYYY-MM-DD
        
        // --- Geração de Horários ---
        const TIME_SLOTS = [];
        for (let h = 8; h <= 19; h++) {
            if(h !== 12) TIME_SLOTS.push(`${h.toString().padStart(2, '0')}:00`);
            if(h !== 12) TIME_SLOTS.push(`${h.toString().padStart(2, '0')}:30`);
        }

        // --- Navegação ---
        window.navigate = (view) => {
            currentView = view;
            document.querySelectorAll('main > div').forEach(el => el.classList.add('hidden'));
            const viewEl = document.getElementById(`view-${view.replace('_', '-')}`);
            if(viewEl) viewEl.classList.remove('hidden');
            
            document.getElementById('btn-logout').classList.toggle('hidden', ['home', 'loading', 'client_auth', 'admin_login'].includes(view));

            if (view === 'user') {
                if(!document.getElementById('client-date').value) {
                    document.getElementById('client-date').value = window.getToday();
                    document.getElementById('client-date').min = window.getToday();
                }
                renderUserView();
            }
            if (view === 'admin_dashboard') {
                if(!document.getElementById('admin-date').value) {
                    document.getElementById('admin-date').value = window.getToday();
                }
                renderAdminDashboard();
            }
        };

        // --- Inicialização ---
    let isSetup = false;
    async function init() {
        onAuthStateChanged(auth, (user) => {
            currentUser = user;
            if (!isSetup) {
                isSetup = true;
                setupRealtime();
                navigate('home');
            }
        });
    }

    // --- Autenticação com Email e Senha ---
    window.doLogout = async () => {
        await signOut(auth);
        currentUser = null;
        navigate('home');
    };

    window.goToClient = () => {
        if (currentUser) navigate('user');
        else navigate('client_auth');
    };

    window.goToAdmin = () => {
        if (currentUser) navigate('admin_dashboard');
        else navigate('admin_login');
    };

    const handleAuthError = (err) => {
        let msg = "Ocorreu um erro na autenticação.";
        if (err.code === 'auth/invalid-email') msg = "E-mail inválido.";
        if (err.code === 'auth/user-not-found') msg = "Usuário não encontrado. Tente criar uma conta primeiro.";
        if (err.code === 'auth/wrong-password' || err.code === 'auth/invalid-credential') msg = "Credenciais incorretas.";
        if (err.code === 'auth/email-already-in-use') msg = "Este e-mail já está em uso.";
        if (err.code === 'auth/weak-password') msg = "A senha deve ter no mínimo 6 caracteres.";
        if (err.message && !msg.includes('auth')) msg += `<br><span class="text-xs text-neutral-500">${err.message}</span>`;
        
        showModal("Erro de Acesso", `<p class="text-white">${msg}</p>`, `<button onclick="closeModal()" class="w-full bg-amber-500 text-black font-bold py-2 rounded-lg">OK</button>`);
    };

    window.handleClientLogin = async () => {
        const e = document.getElementById('client-email').value;
        const p = document.getElementById('client-pass').value;
        if(!e || !p) return showModal("Atenção", "Preencha e-mail e senha.", `<button onclick="closeModal()" class="w-full bg-amber-500 text-black py-2 rounded-lg">OK</button>`);
        try {
            await signInWithEmailAndPassword(auth, e, p);
            document.getElementById('client-email').value = '';
            document.getElementById('client-pass').value = '';
            navigate('user');
        } catch(err) { handleAuthError(err); }
    };

    window.handleClientRegister = async () => {
        const e = document.getElementById('client-email').value;
        const p = document.getElementById('client-pass').value;
        if(!e || !p) return showModal("Atenção", "Preencha e-mail e senha.", `<button onclick="closeModal()" class="w-full bg-amber-500 text-black py-2 rounded-lg">OK</button>`);
        try {
            await createUserWithEmailAndPassword(auth, e, p);
            document.getElementById('client-email').value = '';
            document.getElementById('client-pass').value = '';
            navigate('user');
        } catch(err) { handleAuthError(err); }
    };

    window.handleAdminAuth = async (isRegister) => {
        const e = document.getElementById('admin-email').value;
        const p = document.getElementById('admin-pass').value;
        if(!e || !p) return showModal("Atenção", "Preencha e-mail e senha.", `<button onclick="closeModal()" class="w-full bg-amber-500 text-black py-2 rounded-lg">OK</button>`);
        try {
            if(isRegister) {
                await createUserWithEmailAndPassword(auth, e, p);
            } else {
                await signInWithEmailAndPassword(auth, e, p);
            }
            document.getElementById('admin-email').value = '';
            document.getElementById('admin-pass').value = '';
            navigate('admin_dashboard');
        } catch(err) { handleAuthError(err); }
    };

    let firstLoad = true;
    let prevApptCount = 0;

    function checkFirebaseError(err) {
        console.error("Firebase Erro:", err);
        if(err.code === 'permission-denied') {
            document.getElementById('setup-error-backdrop').classList.remove('hidden');
        }
    }

    function setupRealtime() {
        const apptRef = collection(db, 'artifacts', APP_ID, 'public', 'data', 'appointments');
        const setRef = collection(db, 'artifacts', APP_ID, 'public', 'data', 'settings');

        onSnapshot(query(apptRef), (snap) => {
            appointments = snap.docs.map(d => ({ id: d.id, ...d.data() }));
            
            // Beep para novos agendamentos (Apenas para Admin)
            if(!firstLoad && currentView === 'admin_dashboard' && appointments.length > prevApptCount) {
                playBeep();
            }
            prevApptCount = appointments.length;
            firstLoad = false;

            if (currentView === 'user') renderUserView();
            if (currentView === 'admin_dashboard') renderAdminDashboard();
        }, checkFirebaseError);

        onSnapshot(query(setRef), (snap) => {
            settings = snap.docs.map(d => ({ id: d.id, ...d.data() }));
            if (currentView === 'user') renderUserView();
            if (currentView === 'admin_dashboard') renderAdminDashboard();
        }, checkFirebaseError);

        // Loop global para atualizações de cronômetro
            if(realtimeLoopInterval) clearInterval(realtimeLoopInterval);
            realtimeLoopInterval = setInterval(() => {
                if (currentView === 'user') checkClientAlerts();
                if (currentView === 'admin_dashboard') updateAdminTimers();
            }, 1000);
        }

        // --- Utilitários de Data e Som ---
        window.isDayClosed = (date) => settings.some(s => s.type === 'closed_day' && s.date === date);
        window.isWorkingDay = (dateStr) => {
            const d = new Date(dateStr + "T12:00:00");
            return d.getDay() >= 2 && d.getDay() <= 6; // Terça a Sabado
        };
        
        function playBeep() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                osc.type = 'sine'; osc.frequency.setValueAtTime(880, ctx.currentTime);
                osc.connect(ctx.destination);
                osc.start(); osc.stop(ctx.currentTime + 0.3);
            } catch(e){}
        }

        function formatTimeDiff(ms) {
            if(ms < 0) ms = 0;
            const totalSecs = Math.floor(ms / 1000);
            const m = Math.floor(totalSecs / 60);
            const s = totalSecs % 60;
            return `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
        }

        // --- Modais ---
        window.showModal = (title, bodyHtml, buttonsHtml) => {
            document.getElementById('modal-title').innerHTML = title;
            document.getElementById('modal-body').innerHTML = bodyHtml;
            document.getElementById('modal-footer').innerHTML = buttonsHtml;
            document.getElementById('modal-backdrop').classList.remove('hidden');
        };
        window.closeModal = () => document.getElementById('modal-backdrop').classList.add('hidden');

        // --- LÓGICA DO CLIENTE ---
        window.toggleClientService = (id) => {
            if (clientSelectedServices.includes(id)) {
                clientSelectedServices = clientSelectedServices.filter(s => s !== id);
            } else {
                clientSelectedServices.push(id);
            }
            renderUserView();
        };

        window.renderUserView = () => {
            const dateStr = document.getElementById('client-date').value;
            const closedMsg = document.getElementById('client-date-msg');
            const bookSection = document.getElementById('client-booking-section');
            
            if (!isWorkingDay(dateStr)) {
                closedMsg.textContent = "O salão atende apenas de Terça a Sábado.";
                closedMsg.classList.remove('hidden');
                bookSection.classList.add('hidden');
            } else if (isDayClosed(dateStr)) {
                closedMsg.textContent = "Data indisponível/fechada.";
                closedMsg.classList.remove('hidden');
                bookSection.classList.add('hidden');
            } else {
                closedMsg.classList.add('hidden');
                bookSection.classList.remove('hidden');
            }

            // Render Services
            let svcHtml = '';
            let total = 0;
            SERVICES.forEach(s => {
                const isSelected = clientSelectedServices.includes(s.id);
                if (isSelected) total += s.price;
                svcHtml += `
                    <div onclick="toggleClientService('${s.id}')" class="service-btn ${isSelected ? 'selected' : 'border-neutral-700 bg-neutral-800'} border-2 rounded-xl p-3 flex justify-between items-center cursor-pointer hover:border-amber-700 transition">
                        <span class="font-bold text-white">${s.name}</span>
                        <span class="text-amber-500 font-black">${formatCurrency(s.price)}</span>
                    </div>`;
            });
            document.getElementById('client-services').innerHTML = svcHtml;
            document.getElementById('client-total').textContent = formatCurrency(total);

            // Render Slots
            const dayApps = appointments.filter(a => a.date === dateStr);
            let slotsHtml = '';
            TIME_SLOTS.forEach(time => {
                const isBooked = dayApps.some(a => a.time === time);
                if (isBooked) {
                    slotsHtml += `<div class="bg-neutral-800 text-neutral-500 border border-neutral-700 py-3 rounded-lg text-center font-bold opacity-50 cursor-not-allowed flex flex-col"><span class="line-through">${time}</span><span class="text-[9px] uppercase">Ocupado</span></div>`;
                } else {
                    slotsHtml += `<button onclick="bookSlot('${time}')" class="bg-black hover:bg-amber-500 hover:text-black border border-neutral-700 text-white py-3 rounded-lg font-black transition-colors shadow-sm">${time}</button>`;
                }
            });
            document.getElementById('client-slots').innerHTML = slotsHtml;

            // Render My Appointments
            const myApps = appointments.filter(a => a.userId === currentUser.uid);
            const myAppsList = document.getElementById('client-my-appointments-list');
            const myAppsContainer = document.getElementById('client-my-appointments');
            
            if (myApps.length > 0) {
                myAppsContainer.classList.remove('hidden');
                let myHtml = '';
                myApps.forEach(a => {
                    const svcNames = a.services.map(id => SERVICES.find(s=>s.id===id)?.name).join(', ');
                    let statusBadge = `<span class="bg-neutral-700 text-white text-xs px-2 py-1 rounded">Agendado</span>`;
                    if(a.status === 'called') statusBadge = `<span class="bg-amber-500 text-black font-bold text-xs px-2 py-1 rounded">Chamado!</span>`;
                    if(a.status === 'started') statusBadge = `<span class="bg-red-600 text-white font-bold text-xs px-2 py-1 rounded pulse-red">Em Andamento</span>`;
                    if(a.status === 'completed') statusBadge = `<span class="bg-green-600 text-white font-bold text-xs px-2 py-1 rounded">Finalizado</span>`;
                    
                    myHtml += `
                        <div class="bg-neutral-900 border border-neutral-800 p-4 rounded-xl flex justify-between items-center">
                            <div>
                                <p class="text-white font-black">${a.date.split('-').reverse().join('/')} às ${a.time}</p>
                                <p class="text-neutral-400 text-sm mb-2">${svcNames}</p>
                                ${statusBadge}
                            </div>
                            ${(a.status === 'booked') ? `<button onclick="cancelSlot('${a.id}')" class="text-red-500 hover:text-red-400 text-sm font-bold border border-red-900 px-3 py-1.5 rounded bg-red-900 bg-opacity-20">Cancelar</button>` : ''}
                        </div>
                    `;
                });
                myAppsList.innerHTML = myHtml;
            } else {
                myAppsContainer.classList.add('hidden');
            }
        };

        window.bookSlot = (time) => {
            const name = document.getElementById('client-name').value.trim();
            if(!name) return showModal("Atenção", "Por favor, digite seu nome.", `<button onclick="closeModal()" class="w-full bg-amber-500 text-black font-bold py-2 rounded-lg">OK</button>`);
            if(clientSelectedServices.length === 0) return showModal("Atenção", "Selecione pelo menos um serviço.", `<button onclick="closeModal()" class="w-full bg-amber-500 text-black font-bold py-2 rounded-lg">OK</button>`);

            const dateStr = document.getElementById('client-date').value;
            let total = 0;
            clientSelectedServices.forEach(id => {
                const s = SERVICES.find(x=>x.id===id);
                if(s) total += s.price;
            });

            const body = `<p class="text-neutral-300">Data: <b class="text-white">${dateStr.split('-').reverse().join('/')}</b></p>
                          <p class="text-neutral-300">Horário: <b class="text-white">${time}</b></p>
                          <p class="text-neutral-300">Total: <b class="text-amber-500 text-xl">${formatCurrency(total)}</b></p>`;
            
            const btns = `<button onclick="closeModal()" class="flex-1 border border-neutral-700 text-neutral-400 py-2 rounded-lg">Voltar</button>
                          <button onclick="confirmBooking('${time}', '${name}', ${total})" class="flex-1 bg-amber-500 text-black font-black py-2 rounded-lg">Confirmar</button>`;
            
            showModal("Confirmar Agendamento", body, btns);
        };

        window.confirmBooking = async (time, name, total) => {
        const dateStr = document.getElementById('client-date').value;
        const ref = collection(db, 'artifacts', APP_ID, 'public', 'data', 'appointments');
        try {
            await addDoc(ref, {
                date: dateStr,
                time: time,
                services: [...clientSelectedServices],
                totalPrice: total,
                status: 'booked',
                customerName: name,
                userId: currentUser.uid,
                createdAt: Date.now()
            });
            clientSelectedServices = [];
            document.getElementById('client-name').value = '';
            closeModal();
            renderUserView();
        } catch (err) {
            checkFirebaseError(err);
            closeModal();
        }
    };

    window.cancelSlot = (id) => {
        showModal("Cancelar", "Tem certeza que deseja cancelar?", 
        `<button onclick="closeModal()" class="flex-1 bg-neutral-700 text-white py-2 rounded-lg">Não</button>
         <button onclick="tryDelete('${id}')" class="flex-1 bg-red-600 text-white font-bold py-2 rounded-lg">Sim, Cancelar</button>`);
    };

    window.tryDelete = async (id) => {
        try {
            await deleteDoc(doc(db, 'artifacts', APP_ID, 'public', 'data', 'appointments', id));
            closeModal();
        } catch (err) {
            checkFirebaseError(err);
            closeModal();
        }
    };

    // --- Realtime Client Alerts ---
        function checkClientAlerts() {
            const area = document.getElementById('client-notification-area');
            if(!area || currentView !== 'user') return;
            
            const todayStr = window.getToday();
            const todayApps = appointments.filter(a => a.date === todayStr).sort((a,b) => a.time.localeCompare(b.time));
            
            // Verifica se o usuário tem agendamentos hoje
            const myAppsToday = todayApps.filter(a => a.userId === currentUser.uid && (a.status === 'booked' || a.status === 'called'));
            if(myAppsToday.length === 0) {
                area.innerHTML = '';
                return;
            }

            let alertHtml = '';
            
            myAppsToday.forEach(myApp => {
                // 1. Sou eu que fui chamado?
                if (myApp.status === 'called' && myApp.calledAt) {
                    const elapsed = Date.now() - myApp.calledAt;
                    const timeLeft = (2 * 60 * 1000) - elapsed; // 2 minutos tolerancia
                    
                    if(timeLeft > 0) {
                        alertHtml += `
                            <div class="bg-red-600 text-white p-6 rounded-2xl shadow-[0_0_20px_rgba(220,38,38,0.6)] pulse-red mb-4 text-center">
                                <h2 class="text-3xl font-black uppercase tracking-widest mb-2">Sua Vez!</h2>
                                <p class="text-lg">Dirija-se à cadeira do barbeiro.</p>
                                <div class="text-4xl font-black mt-4 font-mono">${formatTimeDiff(timeLeft)}</div>
                                <p class="text-xs mt-2 opacity-75">Tolerância máxima.</p>
                            </div>
                        `;
                    }
                } 
                // 2. Prepare-se (calculando tempo do cara que tá na cadeira)
                else if (myApp.status === 'booked') {
                    // Descobrir se sou o próximo
                    const startedApp = todayApps.find(a => a.status === 'started');
                    if (startedApp && startedApp.startedAt) {
                        // Todos os booked hoje
                        const pendingApps = todayApps.filter(a => a.status === 'booked');
                        // Se eu for o primeiro da fila
                        if(pendingApps.length > 0 && pendingApps[0].id === myApp.id) {
                            // Qual o tempo do cara da cadeira?
                            const elapsed = Date.now() - startedApp.startedAt;
                            const elapsedMins = elapsed / (1000 * 60);
                            
                            // Calcula meta do cara da cadeira
                            let metaMins = 5; // Default pra pézinho
                            const hasCorteOrBarba = startedApp.services.some(id => id === 'corte' || id === 'barba');
                            if(hasCorteOrBarba) metaMins = 15;

                            if (elapsedMins >= metaMins) {
                                alertHtml += `
                                    <div class="bg-amber-500 text-black p-4 rounded-xl shadow-lg mb-4 flex items-center gap-4">
                                        <div class="w-12 h-12 bg-black rounded-full flex items-center justify-center pulse-red">⚠️</div>
                                        <div>
                                            <h3 class="font-black text-xl">Prepare-se!</h3>
                                            <p class="font-bold text-sm">O cliente atual está quase finalizando.</p>
                                        </div>
                                    </div>
                                `;
                            }
                        }
                    }
                }
            });

            area.innerHTML = alertHtml;
        }

        // --- LÓGICA DO ADMIN ---
        window.renderAdminDashboard = () => {
            const dateStr = document.getElementById('admin-date').value;
            const closed = isDayClosed(dateStr);
            const dayApps = appointments.filter(a => a.date === dateStr);

            // Btn Fechar Dia
            const btnToggle = document.getElementById('btn-toggle-day');
            if (closed) {
                btnToggle.textContent = 'ABRIR DIA';
                btnToggle.className = 'px-4 py-2 rounded-lg font-black border bg-green-900 bg-opacity-20 text-green-500 border-green-800 hover:bg-green-800 hover:text-white transition';
            } else {
                btnToggle.textContent = 'FECHAR DIA';
                btnToggle.className = 'px-4 py-2 rounded-lg font-black border bg-red-900 bg-opacity-20 text-red-500 border-red-800 hover:bg-red-800 hover:text-white transition';
            }

            // Faturamento
            const completed = dayApps.filter(a => a.status === 'completed');
            const revenue = completed.reduce((sum, a) => sum + (a.totalPrice||0), 0);
            document.getElementById('admin-revenue').textContent = formatCurrency(revenue);

            // Slots
            let slotsHtml = '';
            TIME_SLOTS.forEach(time => {
                const app = dayApps.find(a => a.time === time);
                
                if (!app) {
                    // Livre
                    const cl = closed ? 'opacity-30 cursor-not-allowed bg-black' : 'bg-black border-neutral-700 hover:border-neutral-500 cursor-pointer';
                    slotsHtml += `<div onclick="${closed ? '' : `adminBookSlot('${time}')`}" class="border rounded-xl p-3 h-24 flex flex-col justify-between transition ${cl}">
                        <span class="font-black text-neutral-500">${time}</span>
                        <span class="text-xs text-neutral-600 font-bold uppercase">Livre</span>
                    </div>`;
                } else {
                    // Ocupado
                    let bgClass = "bg-amber-500 border-amber-600 text-black"; // booked
                    let txtColor = "text-black";
                    let statusLabel = "Agendado";
                    let extraInfo = ''; // Timers

                    if (app.status === 'called') {
                        bgClass = "bg-orange-500 border-orange-600 text-white pulse-red";
                        txtColor = "text-white";
                        statusLabel = "Chamado";
                        extraInfo = `<div id="timer-${app.id}" class="text-[10px] font-mono font-black mt-1 bg-black text-white px-1 rounded">--:--</div>`;
                    } else if (app.status === 'started') {
                        bgClass = "bg-red-600 border-red-700 text-white pulse-red";
                        txtColor = "text-white";
                        statusLabel = "Em Corte";
                        extraInfo = `<div id="timer-${app.id}" class="text-[10px] font-mono font-black mt-1 bg-black text-amber-500 px-1 rounded">--:--</div>`;
                    } else if (app.status === 'completed') {
                        bgClass = "bg-green-700 border-green-800 text-white opacity-80";
                        txtColor = "text-white";
                        statusLabel = "Finalizado";
                        extraInfo = `<div class="text-[10px] font-black mt-1">${formatCurrency(app.totalPrice)}</div>`;
                    }

                    const svcShort = app.services.map(id => SERVICES.find(s=>s.id===id)?.name.substring(0,3)).join('+');
                    
                    slotsHtml += `<div onclick="adminManageSlot('${app.id}')" class="border rounded-xl p-3 h-24 flex flex-col justify-between cursor-pointer shadow-lg transform hover:scale-105 transition ${bgClass}">
                        <div class="flex justify-between items-start">
                            <span class="font-black text-lg leading-none ${txtColor}">${time}</span>
                            <span class="text-[9px] uppercase font-bold opacity-80 ${txtColor}">${svcShort}</span>
                        </div>
                        <div>
                            <span class="block font-black text-sm truncate leading-tight ${txtColor}">${app.customerName}</span>
                            ${extraInfo}
                        </div>
                    </div>`;
                }
            });
            document.getElementById('admin-slots').innerHTML = slotsHtml;
            updateAdminTimers(); // Força render imediato dos timers
        };

        window.updateAdminTimers = () => {
            if(currentView !== 'admin_dashboard') return;
            const dateStr = document.getElementById('admin-date').value;
            const dayApps = appointments.filter(a => a.date === dateStr);

            dayApps.forEach(app => {
                const timerEl = document.getElementById(`timer-${app.id}`);
                if(!timerEl) return;

                if(app.status === 'called' && app.calledAt) {
                    const elapsed = Date.now() - app.calledAt;
                    let timeLeft = (2 * 60 * 1000) - elapsed;
                    if(timeLeft < 0) timeLeft = 0;
                    timerEl.textContent = formatTimeDiff(timeLeft);
                    if(timeLeft === 0) timerEl.classList.replace('text-white', 'text-red-300');
                } else if (app.status === 'started' && app.startedAt) {
                    const elapsed = Date.now() - app.startedAt;
                    timerEl.textContent = formatTimeDiff(elapsed);
                }
            });
        }

        window.toggleDayStatus = async () => {
        const dateStr = document.getElementById('admin-date').value;
        const setting = settings.find(s => s.type === 'closed_day' && s.date === dateStr);
        try {
            if(setting) {
                await deleteDoc(doc(db, 'artifacts', APP_ID, 'public', 'data', 'settings', setting.id));
            } else {
                await addDoc(collection(db, 'artifacts', APP_ID, 'public', 'data', 'settings'), { type: 'closed_day', date: dateStr });
            }
        } catch (err) {
            checkFirebaseError(err);
        }
    };

    window.adminManageSlot = (appIdStr) => {
            const app = appointments.find(a => a.id === appIdStr);
            if(!app) return;

            if(app.status === 'completed') {
                return showModal("Horário Finalizado", "<p>Este corte já foi recebido e contabilizado.</p>", `<button onclick="closeModal()" class="w-full bg-neutral-700 py-2 rounded font-bold text-white">Fechar</button>`);
            }

            const ref = doc(db, 'artifacts', APP_ID, 'public', 'data', 'appointments', app.id);
            const svcNames = app.services.map(id => SERVICES.find(s=>s.id===id)?.name).join(', ');
            
            let body = `
                <div class="mb-4">
                    <h4 class="font-black text-2xl text-amber-500 uppercase">${app.time} - ${app.customerName}</h4>
                    <p class="text-neutral-400 text-sm mt-1">Serviços: ${svcNames}</p>
                    <p class="text-white font-black text-xl mt-2">Valor: ${formatCurrency(app.totalPrice)}</p>
                </div>
            `;
            let btns = '';

            if (app.status === 'booked') {
            btns = `
                <button onclick="tryUpdate('${app.id}', {status: 'called', calledAt: Date.now()})" class="w-full bg-orange-500 text-white font-black py-3 rounded-lg mb-2">CHAMAR CLIENTE (2 MIN)</button>
                <button onclick="tryDelete('${app.id}')" class="w-full border border-red-900 text-red-500 hover:bg-red-900 font-bold py-2 rounded-lg mb-2">Desmarcar</button>
                <button onclick="closeModal()" class="w-full text-neutral-400 py-2 font-bold">Voltar</button>
            `;
        } else if (app.status === 'called') {
            btns = `
                <button onclick="tryUpdate('${app.id}', {status: 'started', startedAt: Date.now()})" class="w-full bg-red-600 text-white font-black py-3 rounded-lg mb-2">INICIAR CORTE AGORA</button>
                <button onclick="tryDelete('${app.id}')" class="w-full border border-red-900 text-red-500 hover:bg-red-900 font-bold py-2 rounded-lg mb-2">Cliente não apareceu (Pular)</button>
                <button onclick="closeModal()" class="w-full text-neutral-400 py-2 font-bold">Voltar</button>
            `;
        } else if (app.status === 'started') {
            btns = `
                <button onclick="tryUpdate('${app.id}', {status: 'completed', completedAt: Date.now()})" class="w-full bg-green-600 text-white font-black py-4 rounded-lg mb-2">FINALIZAR E RECEBER</button>
                <button onclick="closeModal()" class="w-full text-neutral-400 py-2 font-bold">Voltar</button>
            `;
        }

        showModal("Gerenciar Horário", body, `<div class="flex flex-col w-full">${btns}</div>`);
    };

    window.tryUpdate = async (id, data) => {
        try {
            await updateDoc(doc(db, 'artifacts', APP_ID, 'public', 'data', 'appointments', id), data);
            closeModal();
        } catch (err) {
            checkFirebaseError(err);
            closeModal();
        }
    };

    window.adminBookSlot = (time) => {
            // Interface rápida pro admin marcar
            const body = `
                <input type="text" id="adm-book-name" placeholder="Nome do Cliente" class="w-full bg-black border border-neutral-700 text-white p-3 rounded-lg mb-3">
                <div class="space-y-2">
                    ${SERVICES.map(s => `
                        <label class="flex items-center gap-3 p-2 border border-neutral-800 rounded bg-neutral-900 cursor-pointer">
                            <input type="checkbox" value="${s.id}" class="adm-book-svc w-5 h-5 accent-amber-500">
                            <span class="text-white">${s.name} - ${formatCurrency(s.price)}</span>
                        </label>
                    `).join('')}
                </div>
            `;
            const btns = `
                <button onclick="closeModal()" class="flex-1 bg-neutral-800 text-white py-2 rounded-lg font-bold">Cancelar</button>
                <button onclick="executeAdminBook('${time}')" class="flex-1 bg-amber-500 text-black py-2 rounded-lg font-black">Agendar</button>
            `;
            showModal(`Agendar Encaixe - ${time}`, body, btns);
        };

        window.executeAdminBook = async (time) => {
        const name = document.getElementById('adm-book-name').value;
        const checkboxes = document.querySelectorAll('.adm-book-svc:checked');
        const svcs = Array.from(checkboxes).map(c => c.value);
        
        if(!name || svcs.length === 0) return showModal("Atenção", "Preencha nome e serviço.", `<button onclick="closeModal()" class="w-full bg-amber-500 text-black py-2 rounded">Ok</button>`);
        
        let total = 0;
        svcs.forEach(id => { total += SERVICES.find(s=>s.id===id).price; });
        
        try {
            await addDoc(collection(db, 'artifacts', APP_ID, 'public', 'data', 'appointments'), {
                date: document.getElementById('admin-date').value,
                time: time,
                services: svcs,
                totalPrice: total,
                status: 'booked',
                customerName: name,
                userId: 'admin_panel',
                createdAt: Date.now()
            });
            closeModal();
        } catch (err) {
            checkFirebaseError(err);
            closeModal();
        }
    };

    // Boot
    window.addEventListener('load', init);

</script>
</body>
</html>
